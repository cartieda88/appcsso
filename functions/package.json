{
  "name": "muevete-functions",
  "private": true,
  "main": "lib/src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test lib/test/*.test.js",
    "serve": "npm run build && firebase emulators:start",
    "deploy": "firebase deploy --only functions,firestore",
    "seed": "tsc && node lib/scripts/seed.js",
    "import-directory": "tsc && node lib/scripts/import-directory.js",
    "make-qr": "tsc && node lib/scripts/make-qr.js"
  },
  "dependencies": {
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0",
    "nodemailer": "^10.5.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "typescript": "^7.0.2"
  }
}
