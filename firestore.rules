rules_version = '2';
// Toda escritura pasa por Cloud Functions (registro de QR, puntos, retos).
// Los clientes solo leen lo que necesitan.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isValidator() { return signedIn() && (request.auth.token.validator == true || isAdmin()); }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
      match /{sub=**} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow write: if false;
      }
    }

    // Ranking: nombre, departamento y puntos son visibles para todos los colaboradores.
    match /scores/{id}      { allow read: if signedIn(); allow write: if false; }
    match /deptScores/{id}  { allow read: if signedIn(); allow write: if false; }
    match /departments/{id} { allow read: if signedIn(); allow write: if false; }
    match /challenges/{id}  { allow read: if signedIn(); allow write: if false; }
    match /config/{id}      { allow read: if signedIn(); allow write: if false; }
    // Agenda del Comité: todos la ven; cada quien ve su propia inscripción.
    match /events/{id} {
      allow read: if signedIn();
      allow write: if false;
      match /attendees/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow write: if false;
      }
    }
    // Pasos diarios: solo el propio colaborador y los admin.
    match /steps/{id}       { allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin()); allow write: if false; }
    match /pushLog/{id}     { allow read, write: if false; }
    match /stats/{id}       { allow read: if isAdmin(); allow write: if false; }
    // Sellos pendientes: los ve la mesa de control; se aprueban con la función reviewActivity.
    match /approvals/{id}   { allow read: if isValidator(); allow write: if false; }

    // Nunca accesibles desde la app: tokens de QR, códigos de ingreso y nómina.
    // Actividades configurables: todos las ven; solo se cambian con la función saveActivity.
    match /activities/{id} { allow read: if signedIn(); allow write: if false; }
    // Tokens de QR y nómina: solo Talento Humano (para imprimir QR y gestionar personas).
    match /qrCodes/{id}    { allow read: if isAdmin(); allow write: if false; }
    match /directory/{id}  { allow read: if isAdmin(); allow write: if false; }
    match /loginCodes/{id} { allow read, write: if false; }
  }
}
