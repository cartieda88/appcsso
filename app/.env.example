# Copia este archivo a app/.env y llena los valores de la app web registrada en Firebase
# (Consola de Firebase → Configuración del proyecto → Tus apps → Web).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_ALLOWED_DOMAIN=netlife.net.ec

# Solo para pruebas locales con emuladores: IP de tu computadora en la red Wi-Fi
# (127.0.0.1 si usas el navegador en la misma computadora).
# EXPO_PUBLIC_EMULATOR_HOST=192.168.1.50
