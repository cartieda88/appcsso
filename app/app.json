{
  "expo": {
    "name": "Muévete Netlife",
    "slug": "muevete-netlife",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "muevete",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "ec.net.netlife.muevete",
      "supportsTablet": false,
      "infoPlist": {
        "NSMotionUsageDescription": "Muévete cuenta tus pasos para el reto de pasos y para avisarte cuando llegues a tu meta diaria."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#141416",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ec.net.netlife.muevete",
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#141416",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 260
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Muévete usa la cámara para leer el código QR de los accesos y registrar tu actividad.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      "expo-background-task",
      [
        "expo-notifications",
        {
          "color": "#F5AD20",
          "defaultChannel": "eventos"
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Muévete cuenta tus pasos para el reto de pasos y para avisarte cuando llegues a tu meta diaria."
        }
      ],
      "react-native-health-connect"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}